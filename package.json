{
  "name": "rift",
  "version": "2026.04.12+de62274",
  "description": "Rift - Your voice. Your Mac. Nothing else.",
  "main": "dist/main/main/index.js",
  "author": "Mikko Kiiskila",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"bun run dev:renderer\" \"bun run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "bun run build:electron && wait-on http://localhost:5173 && ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "version": "node scripts/update-version.js",
    "package": "node scripts/check-bundle.js && bun run version && bun run build && electron-builder --mac --publish=never && node scripts/verify-build.js",
    "package:dmg": "node scripts/check-bundle.js && bun run version && bun run build && electron-builder --mac dmg --publish=never && node scripts/verify-build.js",
    "package:zip": "node scripts/check-bundle.js && bun run version && bun run build && electron-builder --mac zip --publish=never && node scripts/verify-build.js",
    "verify-build": "node scripts/verify-build.js",
    "start": "electron .",
    "test:live-paste": "npx ts-node test-engine/index.ts",
    "test:installer": "npx ts-node test-engine/installer-tests.ts",
    "test:installer:bundle": "npx ts-node test-engine/installer-tests.ts --bundle",
    "test:installer:server": "npx ts-node test-engine/installer-tests.ts --server",
    "test:installer:e2e": "npx ts-node test-engine/installer-tests.ts --e2e",
    "test:llm": "npx ts-node test-engine/llm-runner.ts",
    "test:model-compare": "npx ts-node test-engine/model-comparison.ts",
    "test:all": "bun run test:live-paste && bun run test:llm && bun run test:installer",
    "evals": "npx ts-node test-engine/run-all-evals.ts",
    "evals:quick": "npx ts-node test-engine/llm-runner.ts",
    "evals:release": "npx ts-node test-engine/run-all-evals.ts --release-gate",
    "evals:export": "npx ts-node test-engine/export-results.ts",
    "release": "node scripts/release.js",
    "publish-public": "node scripts/publish-public.js",
    "publish-public:dry": "node scripts/publish-public.js --dry-run",
    "bundle:python": "node scripts/bundle-python.js",
    "deploy:website": "wrangler pages deploy website/ --project-name myrift-dev --commit-dirty=true",
    "deploy:diagnostics": "cd workers/rift-diagnostics && wrangler deploy",
    "diagnostics:fetch": "curl -s \"https://rift-diagnostics.mikko-sj-kiiskila.workers.dev/reports?key=$RIFT_ADMIN_KEY\" | python3 -m json.tool",
    "website:vendor-pretext": "mkdir -p website/vendor && cp node_modules/@chenglou/pretext/dist/layout.js website/vendor/pretext.mjs && cp node_modules/@chenglou/pretext/dist/bidi.js node_modules/@chenglou/pretext/dist/analysis.js node_modules/@chenglou/pretext/dist/measurement.js node_modules/@chenglou/pretext/dist/line-break.js website/vendor/",
    "postinstall": "bun run website:vendor-pretext",
    "website:lighthouse": "npx lighthouse@11 http://127.0.0.1:8899/ --only-categories=accessibility,seo,best-practices --chrome-flags='--headless --no-sandbox' --quiet",
    "test:website": "bash scripts/website-visual-check.sh",
    "test:website:update": "bash scripts/website-visual-test.sh",
    "design:audit": "bash scripts/design-audit.sh",
    "ci:first-launch-check": "bash scripts/first-launch-ci-check.sh",
    "test:download-contract": "bun test-engine/model-download-contract-test.ts"
  },
  "keywords": [
    "voice",
    "tts",
    "stt",
    "speech",
    "macos",
    "mlx",
    "apple-silicon"
  ],
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "agent-browser": "^0.24.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@electron/remote": "^2.1.1",
    "@types/three": "^0.182.0",
    "electron-liquid-glass": "^1.1.1",
    "electron-store": "8.2.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.182.0",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "dev.myrift.app",
    "afterAllArtifactBuild": "scripts/notarize.js",
    "productName": "Rift",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist-package"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python-bundle",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "setup",
        "to": "setup",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "identity": "Mikko Kiiskilae (Z27G4HWLJE)",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/assets/*.map"
    ]
  }
}
